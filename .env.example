# Скопируйте этот файл в .env для локального запуска.
# На Railway эти же переменные задаются в разделе Variables проекта —
# сам файл .env туда заливать не нужно (он в .gitignore).

# Gmail-адрес, с которого будут отправляться письма
GMAIL_USER=pinp6390@gmail.com

# App Password из аккаунта Google (16 символов, БЕЗ пробелов)
# Как получить — см. README.md
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Куда присылать заявки (можно не указывать — по умолчанию = GMAIL_USER)
TO_EMAIL=pinp6390@gmail.com

# Через запятую — список доменов, которым разрешено слать запросы к API
ALLOWED_ORIGINS=https://swwixzy.github.io
